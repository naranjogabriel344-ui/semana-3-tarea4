    "def scrapper(url):\n",
    "    # Esta función toma la URL de un perfil de Twitter y extrae información pública.\n",
    "    # Utiliza Selenium para cargar la página y BeautifulSoup para analizar el HTML.\n",
    "    \n",
    "    data={}\n",
    "    options = Options()\n",
    "    options.add_argument('--headless=new') # Ejecuta Chrome en modo headless (sin interfaz gráfica)\n",
    "    \n",
    "    # Usa webdriver-manager para gestionar automáticamente el driver de Chrome.\n",
    "    # Esto evita problemas de incompatibilidad entre el navegador y el driver.\n",
    "    service = Service(ChromeDriverManager().install())\n",
    "    driver = webdriver.Chrome(service=service, options=options)\n",
    "    \n",
    "    driver.get(url)\n",
    "    time.sleep(3)  # Espera para que la página cargue completamente el contenido dinámico.\n",
    "    \n",
    "    resp = driver.page_source\n",
    "    driver.quit() # Cierra el navegador y el proceso del driver.\n",
    "    \n",
    "    soup = BeautifulSoup(resp, 'html.parser')\n",
    "    \n",
    "    # Se utilizan selectores basados en 'data-testid' porque son más estables que las clases CSS,\n",
    "    # que pueden cambiar frecuentemente en sitios como Twitter.\n",
    "    \n",
    "    try:\n",
    "        # Extrae el nombre del perfil.\n",
    "        profile_name_container = soup.find('div', {'data-testid': 'UserName'})\n",
    "        data[\"profile_name\"] = profile_name_container.find('span').text\n",
    "    except Exception as e:\n",
    "        data[\"profile_name\"] = None\n",
    "        \n",
    "    try:\n",
    "        # Extrae el handle de Twitter (ej. @twitter). El handle es parte del nombre, por lo que se busca dentro del mismo contenedor.\n",
    "        data[\"profile_handle\"] = profile_name_container.find_all('span')[2].text\n",
    "    except Exception as e:\n",
    "        data[\"profile_handle\"] = None\n",
    "        \n",
    "    try:\n",
    "        # Extrae la biografía del perfil.\n",
    "        data[\"profile_bio\"] = soup.find(\"div\", {\"data-testid\": \"UserDescription\"}).text\n",
    "    except Exception as e:\n",
    "        data[\"profile_bio\"] = None\n",
    "        \n",
    "    try:\n",
    "        # Extrae el número de usuarios que sigue (Following).\n",
    "        following_element = soup.find('a', href=lambda href: href and '/following' in href)\n",
    "        data[\"profile_following\"] = following_element.find('span').text + ' Following'\n",
    "    except Exception as e:\n",
    "        data[\"profile_following\"] = None\n",
    "        \n",
    "    try:\n",
    "        # Extrae el número de seguidores (Followers).\n",
    "        followers_element = soup.find('a', href=lambda href: href and '/verified_followers' in href)\n",
    "        data[\"profile_followers\"] = followers_element.find('span').text + ' Followers'\n",
    "    except Exception as e:\n",
    "        data[\"profile_followers\"] = None\n",
    "\n",
    "    # Los siguientes campos (categoría, sitio web, fecha de unión) ya no están disponibles\n",
